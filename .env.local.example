# This machine's own configuration for the local stack (`bun run dev`). Copy
# this file to .env.local (gitignored): it overrides .env, and the real
# environment overrides it. Every worktree reads the files at the main
# checkout's root.

# --- Local sign-in: at least one pair -------------------------------------
# OAuth apps that local Supabase Auth signs in with. Each calls back to
# http://127.0.0.1:55321/auth/v1/callback.
SHIPBASH_GITHUB_OAUTH_CLIENT_ID=
SHIPBASH_GITHUB_OAUTH_CLIENT_SECRET=
SHIPBASH_GOOGLE_OAUTH_CLIENT_ID=
SHIPBASH_GOOGLE_OAUTH_CLIENT_SECRET=

# --- Generated: `bun run dev` appends these when they are missing ---------
# Signs the console's calls to the local service; at least 32 bytes.
# SHIPBASH_ACTOR_SIGNING_SECRET=
# Team sign-in sealing keys, <keyId>:<64 hex> pairs separated by commas. The
# first seals new rows; the rest stay listed so a rotation can still read them.
# SHIPBASH_SIGN_IN_ENCRYPTION_KEYS=

# --- Optional --------------------------------------------------------------
# The console's public URL, http://127.0.0.1:4173 when unset; an HTTPS tunnel
# to it when Slack must reach this machine.
# SHIPBASH_PUBLIC_URL=
# SHIPBASH_HOME=/absolute/private/shipbash-home
# SHIPBASH_DOCKER_BINARY=docker
# SHIPBASH_SUITE_RUN_CONCURRENCY=2
# SHIPBASH_ACTIVITY_CONCURRENCY=2
# A Docker memory size for each runner container, or 0/off for no bound.
# SHIPBASH_RUNNER_MEMORY=4g
