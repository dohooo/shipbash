{
  "name": "shipbash-workspace",
  "version": "0.81.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "version": "node scripts/sync-version.mjs",
    "dev": "NODE_OPTIONS=--conditions=development tsx scripts/dev-stack.ts",
    "dev:doctor": "NODE_OPTIONS=--conditions=development tsx scripts/dev-stack.ts --doctor",
    "build": "bun run build:packages && bun run --filter @shipbash/console build",
    "build:packages": "bun run --filter @shipbash/contracts build && bun run --filter @shipbash/runner build && bun run --filter @shipbash/control-plane build",
    "build:web": "bun run build:packages && bun run --filter @shipbash/console build",
    "build:marketing": "bun run --filter shipbash-marketing build",
    "brand:assets": "tsx scripts/generate-shipbash-assets.ts",
    "contracts:generate": "tsx scripts/contracts/database-contracts.ts generate",
    "contracts:check": "tsx scripts/contracts/database-contracts.ts check && bun run contracts:lint",
    "contracts:lint": "biome check packages/control-plane/src/generated/database packages/contracts/src/runtime/generated",
    "gate:prepush": "bash scripts/heavy-lock.sh tsx scripts/gate-prepush.ts",
    "lint": "bun run lint:biome && bun run lint:discipline",
    "lint:biome": "tsx scripts/lint-changed.ts",
    "lint:discipline": "tsx scripts/lint-discipline.ts",
    "lint:discipline:baseline": "tsx scripts/lint-discipline.ts --write-baseline",
    "typecheck": "bun run --workspaces --if-present typecheck && node node_modules/typescript-7/bin/tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:marketing": "bun run --filter shipbash-marketing typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "node scripts/release.mjs",
    "release:cli": "changeset publish",
    "dev:web": "NODE_OPTIONS=--conditions=development bun run --filter @shipbash/console dev",
    "dev:marketing": "bun run --filter shipbash-marketing dev",
    "dev:service": "NODE_OPTIONS=--conditions=development tsx watch packages/control-plane/src/service.ts --port 4174",
    "db:start": "node packages/control-plane/dist/supervisor.js --db-only",
    "db:stop": "node packages/control-plane/dist/supervisor.js --db-stop",
    "db:reset": "node packages/control-plane/dist/supervisor.js --db-reset",
    "db:lint": "node packages/control-plane/dist/supervisor.js --db-lint",
    "docker:build": "node packages/control-plane/dist/build-runner-image.js",
    "storybook": "bun run --filter @shipbash/console storybook"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@shipbash/control-plane": "workspace:*",
    "@shipbash/runner": "workspace:*",
    "@supabase/supabase-js": "2.110.2",
    "@vercel/sandbox": "3.5.1",
    "cron-parser": "5.6.1",
    "next": "16.3.2",
    "pg-boss": "^12.26.0",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "supabase": "2.109.1",
    "tldts": "^7.4.11",
    "tus-js-client": "4.3.1",
    "workflow": "4.8.9",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/node": "22.19.8",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "sharp": "^0.34.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.16",
    "tinyglobby": "0.2.17"
  },
  "engines": {
    "node": ">=22"
  }
}
