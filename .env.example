# ShipBash configuration: the services this ShipBash calls and the
# integrations it offers. Copy this file to .env (gitignored) for the local
# stack; a hosted deployment sets the same names in its platform's environment,
# plus the hosted section at the end. .env.local (see .env.local.example) holds
# this machine's own values and overrides this file; the real environment
# overrides both. `bun run dev` names every required variable that is missing.

# --- Agent services (required) -------------------------------------------
# The model gateway: an OpenAI Responses API endpoint that serves gpt-6.1-sol
# (packages/contracts/src/runtime/agent-model.mjs), such as
# https://api.openai.com/v1, and the key it accepts.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional: "priority" asks the gateway for its priority tier; empty asks for none.
OPENAI_SERVICE_TIER=
# Jev, TypeSafe's browser executor, which walks journey steps and judges pages.
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=

# --- Optional integrations: leave a group empty to switch it off ---------
# Slack alerts and the @ShipBash chat. All three come from one Slack app
# (https://api.slack.com/apps → Basic Information → App Credentials).
# OAuth redirect: <public URL>/api/slack/oauth/callback
# Event subscriptions: <public URL>/api/webhooks/slack
# Slack will not call loopback, so locally SHIPBASH_PUBLIC_URL (.env.local)
# must be an HTTPS tunnel to http://127.0.0.1:4173.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Repository access through your own GitHub App: all four values or none.
# Unset, a console on 127.0.0.1 registers a private App through GitHub's
# manifest flow the first time someone connects GitHub, and a hosted
# deployment has no GitHub. PEM may be one line with literal \n separators.
# Setup callback: <public URL>/api/github/installations/callback
# OAuth callback: <public URL>/api/github/oauth/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# The waiting list. "true" holds every new account on it until it is let in;
# empty lets everyone straight in. The password guards /internal/waitlist;
# empty, the page and its API answer as if they were not there. The Resend
# key and a sender on a domain verified in Resend send the one admission
# email; the local stack logs that email instead of sending it.
SHIPBASH_WAITLIST=
WAITLIST_ADMIN_PASSWORD=
RESEND_API_KEY=
SHIPBASH_EMAIL_FROM=

# "true" holds each team to its monthly Run quota (60 for a new team, set per
# team on /internal/waitlist): a team that has used it starts no new run until
# the month turns. Empty counts Runs against no quota.
SHIPBASH_RUN_QUOTA=

# --- Hosted deployment only: set these in the Vercel project --------------
# The local stack provides its own database, Supabase, secrets and runner, so
# they stay commented here.
# Supabase's Vercel integration writes these five: POSTGRES_URL is its pooled
# connection (Supavisor transaction mode, port 6543), SUPABASE_SECRET_KEY the
# project's server-side key.
# POSTGRES_URL=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The console's origin; a preview deployment falls back to its branch URL.
# SHIPBASH_PUBLIC_URL=
# At least 32 bytes.
# SHIPBASH_ACTOR_SIGNING_SECRET=
# <keyId>:<64 hex> pairs separated by commas; the first seals new rows.
# SHIPBASH_SIGN_IN_ENCRYPTION_KEYS=
# The runner image in the project's Vercel Container Registry.
# SHIPBASH_RUNNER_IMAGE=
# A DNS name you own, resolving to a TEST-NET address (such as 192.0.2.1):
# a task Sandbox calls the job API there and its firewall forwards the call
# to this console.
# SHIPBASH_JOB_API_HOST=
# Sent by Vercel Cron to /api/internal/schedules; at least 16 bytes.
# CRON_SECRET=
# Optional, together: the release's runtime bundle over the image, and the
# token that reads it from private Blob storage.
# SHIPBASH_RUNNER_RUNTIME_VERSION=
# SHIPBASH_RUNNER_RUNTIME_URL=
# BLOB_READ_WRITE_TOKEN=
